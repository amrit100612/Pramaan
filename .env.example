# ==============================================================================
# Pramaan — Environment Variables Template
# Copy this file to .env.local and fill in the values from your dashboards.
# ==============================================================================

# ── Cloudinary (Media Ingestion, AI Vision, Transforms) ───────────────────────
# Cloudinary Dashboard -> Programmable Media -> Dashboard -> Cloud Name
CLOUDINARY_CLOUD_NAME=

# Cloudinary Dashboard -> Programmable Media -> Dashboard -> API Key
CLOUDINARY_API_KEY=

# Cloudinary Dashboard -> Programmable Media -> Dashboard -> API Secret (SERVER-ONLY)
CLOUDINARY_API_SECRET=

# Cloudinary Dashboard -> Settings -> Security -> Webhook signature algorithm (default: sha1, or sha256 if opted-in)
CLOUDINARY_SIGNATURE_ALGORITHM=sha1

# ── Supabase (Database, Auth, pgvector Embeddings) ───────────────────────────
# Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=

# Supabase Dashboard -> Project Settings -> API -> Project API Keys -> service_role (secret, bypasses RLS) (SERVER-ONLY)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Dashboard -> Project Settings -> API -> Project URL (browser-safe copy)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Dashboard -> Project Settings -> API -> Project API Keys -> anon / public (browser-safe)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Vercel AI Gateway / TypeSafe AI Jev (Verdict Engine) ─────────────────────
# Vercel Dashboard -> AI Gateway -> Settings -> API Keys (or TypeSafe AI API key) (SERVER-ONLY)
AI_GATEWAY_API_KEY=

# OpenAI Dashboard -> API Keys -> Secret Key (used for text-embedding-3-small fallback) (SERVER-ONLY)
OPENAI_API_KEY=

# Vision LLM model identifier for borderline escalation (e.g. openai/gpt-4o or anthropic/claude-3-5-sonnet)
ESCALATION_MODEL=openai/gpt-4o
